          "model_id": "deepseek-v4-pro-guan",
          "max_context": 128000,
          "max_output": 1024,
          "capabilities": [
            "chat"
          ],
          "tags": [
            "m1-smoke",
            "carrier"
          ],
          "purpose": "m1_connectivity_smoke",
          "admission": false
        },
        "target": {
          "model_id": "glm-5.2",
          "max_context": 128000,
          "max_output": 4096,
          "capabilities": [
            "chat"
          ],
          "tags": [
            "target",
            "placeholder"
          ],
          "purpose": "runtime_target_placeholder",
          "admission": false
        }
      }
    }
  }
}
