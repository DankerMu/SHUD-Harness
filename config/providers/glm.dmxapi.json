{
  "schema_version": "m1.glm-provider.v1",
  "default_provider": "glm-dmxapi",
  "default_model": "glm-dmxapi/target",
  "fallback_chain": [
    "glm-dmxapi/target"
  ],
  "task_closure_model": "glm-dmxapi/target",
  "context_compaction_model": "glm-dmxapi/target",
  "fallback_smoke_model": "glm-dmxapi/smoke",
  "smoke_model": "deepseek-v4-pro-guan",
  "target_model_id": "glm-5.2",
