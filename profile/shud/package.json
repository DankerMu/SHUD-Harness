{
  "name": "@shud-harness/dsh-profile-shud",
  "version": "0.9.0",
  "description": "SHUD-Harness dsh bundle: model routing via DMXAPI, outbound session-log channel disabled, dsh-shud-* plugin mounts",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2"
  },
  "dependencies": {
    "@shud-harness/dsh-shud-jobs": "workspace:*",
    "@shud-harness/dsh-shud-policy-gate": "workspace:*",
    "@shud-harness/dsh-shud-presets": "workspace:*",
    "@shud-harness/dsh-shud-raw-guard": "workspace:*",
    "@shud-harness/dsh-shud-tools": "workspace:*"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}
