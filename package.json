{
  "name": "shud-harness",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .git-hooks",
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "lint:staged": "lint-staged",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dup": "jscpd",
    "deadcode": "knip",
    "naming:check": "sh .git-hooks/check-naming.sh --all",
    "commitlint": "commitlint --edit",
    "schema:generate": "node scripts/schema/generate.ts",
    "test:schema-generation": "node scripts/schema/generate.ts --self-test",
    "schema:check": "sh scripts/schema/check.sh",
    "docs:links": "sh scripts/docs/check_links.sh",
    "docs:paths": "sh scripts/docs/check_paths.sh",
    "instructions:render": "sh scripts/instructions/render.sh",
    "instructions:check": "sh scripts/instructions/render.sh --check",
    "adr:check": "sh scripts/adr/verify.sh",
    "docs:check": "pnpm run docs:links && pnpm run docs:paths && pnpm run instructions:check && pnpm run adr:check",
    "pr:size": "sh scripts/guardrails/pr-size.sh",
    "security:secrets": "gitleaks git --no-banner --redact",
    "security:sast": "semgrep scan --config p/typescript --config p/secrets --error --metrics=off --exclude SHUD --exclude rSHUD --exclude AutoSHUD",
    "profile:install": "sh scripts/runtime/profile-install.sh",
    "profile:smoke": "sh scripts/runtime/profile-smoke.sh",
    "raw-guard:probes": "sh scripts/runtime/raw-guard-probes.sh",
    "shud:tiny": "sh scripts/runtime/shud-tiny.sh",
    "test-guardrails": "sh scripts/guardrails/test-guardrails.sh",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test:coverage && pnpm run dup && pnpm run deadcode && pnpm run naming:check && pnpm run schema:check && pnpm run docs:check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5",
    "zod": "4.4.3"
  }
}
