{
  "name": "shud-harness",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "schema:generate": "node scripts/schema/generate.ts",
    "test:schema-generation": "node scripts/schema/generate.ts --self-test",
    "schema:check": "sh scripts/schema/check.sh",
    "docs:links": "sh scripts/docs/check_links.sh",
    "check": "pnpm run typecheck && pnpm run test && pnpm run schema:check && pnpm run docs:links"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vitest": "4.1.11",
    "zod": "4.4.3"
  }
}
