{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "bash .codex/hooks/large-file-guard/large-file-guard.sh",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "exec_command|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/guardrails/no-bypass.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
