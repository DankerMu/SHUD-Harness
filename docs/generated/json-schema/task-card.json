{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shud-harness.local/generated/json-schema/task-card.json",
  "title": "TaskCard",
  "type": "object",
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": [
        "engineering",
        "science_assist",
        "ops"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "created",
        "planned",
        "running",
        "parked",
        "reporting",
        "awaiting_pi",
        "done",
        "cancelled",
        "blocked"
      ]
    },
    "runtime_phase": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "running_local",
            "submitted_job",
            "waiting_for_job",
            "collecting"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question_or_goal": {
      "type": "string",
      "minLength": 1
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "current_owner": {
      "type": "string",
      "minLength": 1
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "stack_id": {
      "type": "string",
      "minLength": 1
    },
    "data_id": {
      "type": "string",
      "minLength": 1
    },
    "inference_budget": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "cheap",
            "normal",
            "deep"
          ]
        },
        "advisory_usd": {
          "type": "number",
          "minimum": 0
        },
        "advisory_model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reviewer_enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "mode"
      ]
    },
    "linked_jobs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "linked_reports": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "theory_bundle_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "task_id",
    "type",
    "status",
    "title",
    "question_or_goal",
    "created_by",
    "current_owner",
    "reviewer",
    "inference_budget",
    "linked_jobs",
    "linked_reports",
    "created_at",
    "updated_at"
  ]
}
