{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shud-harness.local/generated/json-schema/data-provenance.json",
  "title": "DataProvenance",
  "type": "object",
  "properties": {
    "data_id": {
      "type": "string",
      "pattern": "^DATA-[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$"
    },
    "basin": {
      "type": "string",
      "minLength": 1
    },
    "event_window": {
      "type": "object",
      "properties": {
        "start": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "end": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "start",
        "end"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "object",
      "properties": {
        "input_root": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "minLength": 1
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "path",
              "sha256",
              "size_bytes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "input_root",
        "files"
      ],
      "additionalProperties": false
    },
    "preprocess": {
      "type": "null",
      "const": null
    },
    "uncertainty_notes": {
      "type": "null",
      "const": null
    }
  },
  "required": [
    "data_id",
    "basin",
    "event_window",
    "sources",
    "preprocess",
    "uncertainty_notes"
  ],
  "additionalProperties": false
}
