{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shud-harness.local/generated/json-schema/analysis-plan.json",
  "title": "AnalysisPlan",
  "type": "object",
  "properties": {
    "analysis_plan_id": {
      "type": "string",
      "pattern": "^PLAN-[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^TASK-[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$"
    },
    "mode": {
      "type": "string",
      "const": "sensitivity",
      "description": "Only the literal sensitivity is allowed."
    },
    "strategy": {
      "type": "string",
      "const": "one_at_a_time",
      "description": "Only the literal one_at_a_time is allowed."
    },
    "input_dir": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "string"
    },
    "end_days": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "threads": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "parameter_sets": {
      "minItems": 3,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "parameter_set_id": {
            "type": "string",
            "pattern": "^PSET-[1-5]$"
          },
          "label": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "baseline": {
            "type": "boolean"
          },
          "changes": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "enum": [
                "GEOL_KSATH",
                "GEOL_KSATV",
                "LC_ROUGH",
                "RIV_ROUGH"
              ]
            },
            "additionalProperties": {
              "type": "number",
              "minimum": 0.5,
              "maximum": 2
            }
          }
        },
        "required": [
          "parameter_set_id",
          "label",
          "baseline",
          "changes"
        ],
        "additionalProperties": false
      },
      "description": "Requires 3–5 parameter sets. Runtime validation requires exactly one empty baseline, one changed key per perturbation, sequential PSET ids and distinct changes. Multipliers must differ from 1. Baseline position is unrestricted; parameter sets have no persisted run status."
    },
    "parameter_space_rationale": {
      "type": "object",
      "properties": {
        "proposed_by": {
          "type": "string",
          "const": "agent",
          "description": "Only the literal agent is allowed."
        },
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "confirmed_by": {
          "type": "null",
          "description": "Only null is allowed; M5 has no plan confirmation path."
        }
      },
      "required": [
        "proposed_by",
        "basis",
        "confirmed_by"
      ],
      "additionalProperties": false
    },
    "input_digests": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\.{1,2}(?:\\/|$))[^/\\0]+(?:\\/(?!\\.{1,2}(?:\\/|$))[^/\\0]+)*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64,
        "pattern": "^[0-9a-f]{64}$"
      },
      "description": "Runtime validation requires exactly <project>.cfg.calib and the deduplicated whitelist table filenames used by parameter_sets; values identify the original input bytes."
    },
    "created_by": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    }
  },
  "required": [
    "analysis_plan_id",
    "task_id",
    "mode",
    "strategy",
    "input_dir",
    "project",
    "end_days",
    "threads",
    "parameter_sets",
    "parameter_space_rationale",
    "input_digests",
    "created_by",
    "created_at"
  ],
  "additionalProperties": false
}
