{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shud-harness.local/generated/json-schema/idempotency-record.json",
  "title": "IdempotencyRecord",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "string",
      "enum": [
        "task",
        "job",
        "report",
        "notification",
        "pi_gate",
        "export"
      ]
    },
    "request_digest": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "started",
        "completed",
        "failed"
      ]
    },
    "result_ref": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "key",
    "scope",
    "request_digest",
    "status",
    "created_at",
    "updated_at"
  ]
}
