{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shud-harness.local/generated/json-schema/stack-lock.json",
  "title": "StackLock",
  "type": "object",
  "properties": {
    "stack_id": {
      "type": "string",
      "pattern": "^STACK-[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
    },
    "repos": {
      "type": "object",
      "properties": {
        "SHUD": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "commit",
            "branch"
          ],
          "additionalProperties": false
        },
        "rSHUD": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "commit",
            "branch"
          ],
          "additionalProperties": false
        },
        "AutoSHUD": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "commit",
            "branch"
          ],
          "additionalProperties": false
        },
        "zero": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "commit",
            "branch"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "SHUD",
        "rSHUD",
        "AutoSHUD",
        "zero"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "r_version": {
          "type": "string",
          "minLength": 1
        },
        "r_packages_lock": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "sundials_version": {
          "type": "string",
          "minLength": 1
        },
        "gcc_version": {
          "type": "string",
          "minLength": 1
        },
        "gdal_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "os",
        "r_version",
        "r_packages_lock",
        "python_version",
        "sundials_version",
        "gcc_version",
        "gdal_version"
      ],
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "cli_version": {
          "type": "string",
          "minLength": 1
        },
        "prompt_pack": {
          "type": "string",
          "minLength": 1
        },
        "skills_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version",
        "cli_version",
        "prompt_pack",
        "skills_version"
      ],
      "additionalProperties": false
    },
    "llm": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "params_digest": {
          "type": "string",
          "minLength": 1
        },
        "prompt_pack_digest": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "provider",
        "model_id",
        "base_url",
        "params_digest",
        "prompt_pack_digest"
      ],
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "stack_id",
    "repos",
    "runtime",
    "harness",
    "llm",
    "fingerprint",
    "created_at"
  ],
  "additionalProperties": false
}
