{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shud-harness.local/generated/json-schema/stack-lock.json",
  "title": "StackLock",
  "type": "object",
  "properties": {
    "stack_id": {
      "type": "string",
      "pattern": "^STACK-[0-9]{8}T[0-9]{6}-[0-9a-f]{4}$"
    },
    "repos": {
      "type": "object",
      "properties": {
        "SHUD": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "dirty": {
              "type": "boolean"
            },
            "dirty_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dirty_paths_truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "commit",
            "branch",
            "dirty",
            "dirty_paths",
            "dirty_paths_truncated"
          ],
          "additionalProperties": false
        },
        "rSHUD": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "dirty": {
              "type": "boolean"
            },
            "dirty_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dirty_paths_truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "commit",
            "branch",
            "dirty",
            "dirty_paths",
            "dirty_paths_truncated"
          ],
          "additionalProperties": false
        },
        "AutoSHUD": {
          "type": "object",
          "properties": {
            "commit": {
              "type": "string",
              "minLength": 1
            },
            "branch": {
              "type": "string",
              "minLength": 1
            },
            "dirty": {
              "type": "boolean"
            },
            "dirty_paths": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "dirty_paths_truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "commit",
            "branch",
            "dirty",
            "dirty_paths",
            "dirty_paths_truncated"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "SHUD",
        "rSHUD",
        "AutoSHUD"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "os": {
          "type": "string",
          "minLength": 1
        },
        "sundials_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "host_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "os",
        "sundials_version",
        "host_version"
      ],
      "additionalProperties": false
    },
    "harness": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "version"
      ],
      "additionalProperties": false
    },
    "llm": {
      "type": "object",
      "properties": {
        "base_url": {
          "type": "string",
          "minLength": 1
        },
        "request_alias": {
          "type": "string",
          "minLength": 1
        },
        "response_model": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "base_url",
        "request_alias",
        "response_model"
      ],
      "additionalProperties": false
    },
    "fingerprint": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "stack_id",
    "repos",
    "runtime",
    "harness",
    "llm",
    "fingerprint",
    "created_at"
  ],
  "additionalProperties": false
}
