{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["profile/shud"],
  "rules": {
    "duplicates": "warn"
  },
  "workspaces": {
    ".": {
      "entry": ["scripts/runtime/profile-patch.ts"],
      "project": ["scripts/**/*.ts"]
    },
    "packages/dsh-shud-core": {
      "entry": ["src/**/*.test.ts", "src/run-identifiers.typecheck.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dsh-shud-jobs": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dsh-shud-raw-guard": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks", "semgrep"]
}
