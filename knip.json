{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": ["profile/shud"],
  "rules": {
    "duplicates": "error"
  },
  "workspaces": {
    ".": {
      "entry": [
        "scripts/runtime/profile-patch.ts",
        "scripts/runtime/shud-restart.ts",
        "scripts/runtime/shud-first-task.ts"
      ],
      "project": ["scripts/**/*.ts"]
    },
    "packages/dsh-shud-core": {
      "entry": ["src/**/*.test.ts", "src/run-identifiers.typecheck.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dsh-shud-records": {
      "entry": ["src/**/*.test.ts", "src/workspace-records.typecheck.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dsh-shud-jobs": {
      "entry": ["src/**/*.test.ts", "src/shud-end.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dsh-shud-tools": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dsh-shud-policy-gate": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dsh-shud-presets": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/dsh-shud-raw-guard": {
      "entry": ["src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreBinaries": ["gitleaks", "semgrep", "mkfifo"]
}
